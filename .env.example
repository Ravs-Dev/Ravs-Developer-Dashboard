# App server
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Register an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=replace-with-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret
GITHUB_OAUTH_SCOPES=read:user

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_MAX_AGE_DAYS=1

# Set a real, monitored support inbox before public deployment.
SUPPORT_EMAIL=ravszz0101@gmail.com
