{
  "name": "ravs-developer-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A secure GitHub developer dashboard for Ravs-Dev, deployed on Vercel.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check server/security.js && node --check server/github.js && node --test"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.1.0"
  }
}
